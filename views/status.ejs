<%- include('../partials/head', { title: 'อัปเดตสถานะออเดอร์ (เคาน์เตอร์)', refresh: list.length === 0 ? 10 : 0 }) %>
<body>
<div class="staff">
  <%- include('../partials/staff-top', { roleLabel: 'หน้าเคาน์เตอร์' }) %>

  <main class="s-main">
    <!-- ===== หัวข้อหน้าอัปเดตสถานะ ===== -->
    <h1 class="s-title">🔄 อัปเดตสถานะออเดอร์</h1>
    <% if (success) { %><div class="alert alert-green" role="status">✔ ออเดอร์ #<%= success %> พร้อมเสิร์ฟ ส่งแจ้งเตือนไปที่หน้าจอลูกค้าแล้ว</div><% } %>

    <div class="status-layout">
      <!-- ===== รายการออเดอร์ที่ปรุงเสร็จ ===== -->
      <section class="o-list">
        <% if (list.length === 0) { %><p class="muted">ไม่มีออเดอร์ที่รออัปเดต</p><% } %>
        <% list.forEach(function (o) { %>
          <a class="o-row <%= selected && selected.Order_ID === o.Order_ID ? 'selected' : '' %>" href="?id=<%= o.Order_ID %>">
            <div class="o-row-top">
              <span class="o-no"><%= orderNo(o.Reference_Code) %></span>
              <span>โต๊ะ <%= o.Table_Number %></span>
              <span class="muted"><%= o.Order_Time %> น.</span>
            </div>
            <span class="badge badge-green"><%= o.Order_Status %></span>
          </a>
        <% }) %>
      </section>

      <!-- ===== รายละเอียด + ขั้นตอนสถานะ ===== -->
      <% if (selected) { %>
        <section class="panel">
          <div class="detail-head">
            <div><span class="o-no"><%= orderNo(selected.Reference_Code) %></span> <span class="muted">โต๊ะ <%= selected.Table_Number %></span></div>
            <span class="badge badge-green"><%= selected.Order_Status %></span>
          </div>
          <div class="food-visual">
            <div class="plate">🍲</div>
            <ul class="o-items" style="flex:1">
              <% selected.items.forEach(function (it) { %>
                <li><span>• <%= it.Menu_Name %> <% if (it.Spiciness_Level) { %><span class="spice">🌶 <%= it.Spiciness_Level %></span><% } %></span><span>x<%= it.Quantity %></span></li>
              <% }) %>
            </ul>
          </div>

          <h3>สถานะปัจจุบัน</h3>
          <% var ready = selected.Order_Status === STATUS.READY || selected.Order_Status === STATUS.DONE; %>
          <ul class="vstep">
            <li class="done"><span class="dot">✓</span>กำลังเตรียมอาหาร</li>
            <li class="done"><span class="dot">✓</span>ปรุงเสร็จสิ้น</li>
            <li class="<%= ready ? 'done' : 'now' %>"><span class="dot"><%= ready ? '✓' : '🛎' %></span>พร้อมรับอาหาร</li>
          </ul>

          <!-- ===== ปุ่มเปลี่ยนเป็นพร้อมเสิร์ฟ ===== -->
          <% if (selected.Order_Status === STATUS.COOKED) { %>
            <form method="post" action="/counter/status/<%= selected.Order_ID %>">
              <button class="btn btn-red btn-block" type="submit">✓ เปลี่ยนเป็น "พร้อมรับอาหาร"</button>
            </form>
          <% } %>
        </section>
      <% } %>
    </div>
  </main>

  <%- include('../partials/counter-nav') %>
</div>
</body>
</html>
